#a #b #n #i
@a = 0
@b = 0
@n = 20
@i = 0

:loop
	@i++
	@_1 = @i
	=> fib
	@_1 = @_
	=> output
	<< 10
	? @i == @n,
		=> end
	;
		=> loop
	.

:fib
@_1--
=> fib
@a = @_
@_1--
=> fib
@a = @a + @_
\ a

:output
#cnt #digit
@cnt = 0
@digit = '0'
? @_1 < 10,
	](@_1 + '0')
	@cnt++
;
	](@_1 % 10 + '0')
	@cnt++
	@_1 = @_1 / 10
	=> output
.
:outputloop
? @cnt,
	[ digit
	<< digit + '0'
	@cnt--
	=> outputloop
;
	\
.

:end
