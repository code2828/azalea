#a #b #n #i
@a = 0
@b = 0
@c = 0
@n = 6
@i = 0
`calcs fib of i and stores result in b`
:fib
	]@c ]@i
	@b = 0 @c = 0
	? i == 1, @b = 1
	;? i == 2, @b = 1
	;? i == 3, @b = 2
	;
	@i--
	^fib `call fib with i-1, result stored in b, moved to c`
	@c = @b
	@i--
	^fib `call fib with i-2, result stored in b`
	@b = @b + @c
	...
	[i [c
	\

:loop
	@i++
	^fib
	<< @b + '0' << ' '
	? @i > 5, ^1; ^loop.
:1
